# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# --- Web app access ---
# A single shared password that gates the web UI. Use a long random string.
APP_PASSWORD=change-me-to-a-long-random-string

# --- Optional ---
# MAX_UPLOAD_BYTES=2097152   # max upload size in bytes (default 2 MB)
# PORT=8000                  # local port (Render sets this automatically)
